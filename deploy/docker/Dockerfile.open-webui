# Hive-branded Open WebUI image.
#
# Upstream Open WebUI hardcodes a license-enforcement suffix: any custom
# WEBUI_NAME gets " (Open WebUI)" appended (backend/open_webui/env.py,
# WEBUI_NAME != 'Open WebUI' check) unless the deployment stays at <=50 end
# users per rolling 30 days, has written vendor permission, or holds an
# enterprise license (Open WebUI License, clause 4 -- see
# ghcr.io/open-webui/open-webui:v0.10.2 LICENSE). This demo deployment
# qualifies under the <=50-user carve-out; owner has authorized full removal
# regardless. Re-evaluate before any rollout that could exceed 50 users/30
# days -- get written permission or an enterprise license first.
FROM ghcr.io/open-webui/open-webui:v0.10.2@sha256:9fcea9c6e32ab60b0498f3986c6cdf651ddbe61db48d2213a3d28048ddd673d4

# Root cause of "(Open WebUI)" in /api/config, /manifest.json,
# /opensearch.xml, and the client-rendered <title>/meta description: this
# 2-line block. WEBUI_NAME itself is still fully configurable via env var
# (see docker-compose.yml); this only removes the forced suffix.
RUN sed -i "/if WEBUI_NAME != 'Open WebUI':/,+1d" /app/backend/open_webui/env.py \
    && ! grep -q '(Open WebUI)' /app/backend/open_webui/env.py

# The pre-hydration static shell (served before the SPA's JS sets the real
# title from WEBUI_NAME) still literally says "Open WebUI" -- it's baked
# into the prebuilt frontend bundle, not templated. ponytail: plain string
# swap, not a full frontend rebuild; add a proper i18n'd title if this
# static shell ever needs more than a brand name.
#
# Both patches assert their own effect (grep -q the old pattern is gone) and
# fail the build otherwise -- sed exits 0 on a zero-match address, so without
# this a future digest bump whose upstream source shifted would silently
# rebuild with "(Open WebUI)" branding back and no build-time signal.
RUN sed -i 's/<title>Open WebUI<\/title>/<title>Hive<\/title>/' /app/build/index.html \
    && ! grep -q '<title>Open WebUI</title>' /app/build/index.html

# /manifest.json is generated by the backend rather than served from
# STATIC_DIR, so no file dropped into owui-static can reach it. Its name and
# short_name already follow WEBUI_NAME, but its description, background colour
# and maskable icon were all still Open WebUI's. See the patch module for what
# each one was and why it matters; it asserts every replacement matched and
# re-parses the module, same posture as the patches around it.
COPY deploy/docker/owui-patches/apply_manifest_patch.py /tmp/apply_manifest_patch.py
RUN python3 /tmp/apply_manifest_patch.py

# Contract check for the empty-state icon override in owui-static/custom.css.
#
# That override replaces the emoji glyph upstream uses as the primary visual
# anchor of its Workspace empty states, and it can only match by structural
# Tailwind classes because the markup carries no id, data attribute, or i18n
# hook. Two properties make the override safe, and both are asserted here so a
# future digest bump fails the build instead of silently un-branding those
# screens (or, worse, matching something new):
#
#   1. The glyph div still uses the `text-3xl mb-3` class pair.
#   2. Every occurrence of that pair is still an emoji-only glyph -- i.e. no
#      occurrence is followed by real text. If one ever is, the `font-size: 0`
#      collapse in custom.css would hide legible content, so the build stops.
#
# Same posture as the two sed patches above, which also assert their own effect.
RUN set -eu; \
    hits=$(grep -roh 'text-3xl mb-3' /app/build/_app/immutable --include='*.js' | wc -l); \
    test "$hits" -ge 1 || { \
      echo "owui-static/custom.css empty-state override is dead: no 'text-3xl mb-3' in this build" >&2; \
      exit 1; }; \
    grep -rohP "text-3xl mb-3\">.{0,4}" /app/build/_app/immutable --include='*.js' \
      | grep -vP "text-3xl mb-3\">[^<[:alnum:][:space:]]" > /tmp/textual || true; \
    if [ -s /tmp/textual ]; then \
      echo "owui-static/custom.css empty-state override now matches textual content:" >&2; \
      cat /tmp/textual >&2; \
      exit 1; \
    fi; \
    echo "empty-state override: $hits emoji-only glyph site(s) confirmed"

# #457: Supabase's third-party OIDC id_token (used for the "Continue with
# Hive" OAuth login) carries only minimal standard OIDC claims -- no
# custom owui_role claim, no user_metadata -- so Open WebUI's own
# OAUTH_ROLES_CLAIM machinery can never resolve a real tenant role for
# any login after its own first-ever-user bypass, permanently stranding
# every other user on Account Activation Pending (confirmed live against
# the physical demo box). psycopg2 and a working Postgres connection
# string (PGVECTOR_DB_URL) already exist in this image for pgvector, so
# splice in a direct tenant-role lookup instead of trying to route this
# through OAuth claims Supabase's third-party token flow will never carry.
COPY deploy/docker/owui-patches/tenant_role_from_db.py /tmp/tenant_role_from_db.py
COPY deploy/docker/owui-patches/apply_tenant_role_patch.py /tmp/apply_tenant_role_patch.py
RUN python3 /tmp/apply_tenant_role_patch.py \
    && grep -q 'hive tenant-role lookup failed' /app/backend/open_webui/utils/oauth.py

# #722: Open WebUI persists every rag.* setting on first boot and its
# seed_defaults only inserts keys that are missing, so a compose change to
# RAG_EMBEDDING_MODEL never reaches a deployment that has already booted. The
# demo box kept embedding against "text-embedding-3-small", the value compose
# shipped between 2026-05-18 and 2026-07-26, which no Hive catalog alias
# matches, so every document upload came back 404 from /v1/embeddings. Splice a
# per-key reconcile into that startup path instead of turning Open WebUI's
# whole persisted config off, which would also revert every setting an
# administrator changed in its own UI. The module names no model itself; the
# alias comes from the environment (D-001).
COPY deploy/docker/owui-patches/hive_rag_env_config.py /app/backend/open_webui/utils/hive_rag_env_config.py
COPY deploy/docker/owui-patches/apply_rag_env_config_patch.py /tmp/apply_rag_env_config_patch.py
RUN python3 /tmp/apply_rag_env_config_patch.py \
    && grep -q 'hive: reconciled Open WebUI config from env' /app/backend/open_webui/config.py \
    && python3 -c "import ast, pathlib; ast.parse(pathlib.Path('/app/backend/open_webui/config.py').read_text())"

# #772: remove the stock Open WebUI surfaces that have no Hive counterpart --
# Workspace > Models (a second, instance-wide model registry that duplicates
# the Hive catalog), Workspace > Prompts, Workspace > Tools, the Playground,
# and the vendor's own Documentation and Releases links in the user menu.
# Workspace > Knowledge stays: it is the document upload behind the RAG
# surface and Hive's analogue of Claude Projects.
#
# Configuration cannot do this job. Every one of those gates reads
# `role === 'admin' || <permission>`, and this deployment promotes every
# tenant owner to Open WebUI admin (the tenant-role patch above), so a
# permission-based hide hides nothing from the people who use it. v0.10.2 has
# no environment variable for any of them either; in particular ENABLE_PLUGINS,
# which third-party Open WebUI hardening guides recommend for exactly this,
# does not exist anywhere in this image. Notes, Calendar and Automations do
# have real flags and are handled by docker-compose.yml plus the reconcile
# above, not here.
#
# The image ships a prebuilt bundle and no frontend source, so this rewrites
# that bundle. It asserts every rewrite matched its exact expected site count,
# that none survived, and that the surfaces Hive keeps are still present, so a
# digest bump fails the build rather than silently restoring a removed surface.
COPY deploy/docker/owui-patches/hive_ui_surfaces.py /tmp/hive_ui_surfaces.py
COPY deploy/docker/owui-patches/apply_ui_surfaces_patch.py /tmp/apply_ui_surfaces_patch.py
RUN python3 /tmp/apply_ui_surfaces_patch.py
# Chat was broken on every route because Open WebUI attached tool schemas that
# no route in this deployment can serve.
#
# Open WebUI 0.10 injects its builtin tools (time, knowledge, chats, tasks,
# notes, channels) into every UI chat request whenever native function calling
# is on, and native is its hardcoded default: main.py resolves
# `function_calling` from the request body, then from the model registry row,
# then from the literal 'native'. This deployment populates no model registry
# (nothing curates one, and #772 removed the Workspace > Models page that
# would), so that literal always won and every request carried 21 tool specs,
# 12089 bytes of JSON, measured against this pinned
# image. On Groq that is 3144 prompt tokens for a one word answer that costs 52
# tokens without them.
#
# Both live chat failures were that payload, reproduced directly against the
# providers with the exact specs this image generates. OpenRouter answers 404
# "No endpoints found that support tool use. Try disabling
# get_current_timestamp", and the Groq free tier answers 429 against its 6000
# token per minute ceiling, since one turn plus Open WebUI's own title, tag and
# follow up task calls repeat those schemas several times inside one minute.
#
# Unlike the rag.* keys above, this is not persisted config: there is nothing
# for hive_rag_env_config.py to reconcile and upstream reads no environment
# variable for it at all. The default is a literal, so make the literal
# environment driven and let compose choose. docker-compose.yml sets
# HIVE_DEFAULT_FUNCTION_CALLING from OWUI_DEFAULT_FUNCTION_CALLING, default
# "legacy", which is Open WebUI's own name for its pre native tool path
# (utils/middleware.py gates every builtin injection on
# params.function_calling != 'legacy'). Leaving the variable unset keeps
# upstream behaviour exactly as it was, and a user who picks native in their
# own advanced params still wins, because the request body is consulted first.
RUN sed -i "s/or 'native'/or os.environ.get('HIVE_DEFAULT_FUNCTION_CALLING', 'native')/" /app/backend/open_webui/main.py \
    && grep -q "HIVE_DEFAULT_FUNCTION_CALLING" /app/backend/open_webui/main.py \
    && ! grep -q "or 'native'" /app/backend/open_webui/main.py \
    && python3 -c "import ast, pathlib; ast.parse(pathlib.Path('/app/backend/open_webui/main.py').read_text())"

# #771: drop the Settings > Integrations tab, the chat UI's only entry point to
# "Manage Tool Servers" and "Open Terminal". Both accept an arbitrary URL and an
# auth credential. The tool servers added there are direct ones, called by the
# browser itself, so they bypass the Hive gateway entirely and no rule on the
# chat origin can reach them; removing the form is the only control that does.
# Caddyfile.owui blocks the server-side half (#770, the /api/v1/terminals proxy
# and the tool and terminal server registration endpoints), and this removes the
# UI so nothing left in the interface points at a path that now 404s.
#
# The patch asserts its own effect and fails the build otherwise, same posture
# as the patches above. The read-back grep is a second, independent check that
# the descriptor is gone from the emitted bundle.
COPY deploy/docker/owui-patches/remove_integrations_tab.py /tmp/remove_integrations_tab.py
RUN python3 /tmp/remove_integrations_tab.py \
    && ! grep -rq 'id:"tools",title:"Integrations"' /app/build/_app/immutable
