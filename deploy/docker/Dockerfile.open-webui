# Hive-branded Open WebUI image.
#
# The frontend is ours and is built from source. `vendor/open-webui` is the
# upstream repository at v0.10.2, added as a squashed git subtree, and this
# first stage compiles it exactly the way upstream's own Dockerfile does:
# node:24-alpine3.24, `npm ci --force`, `npm run build`. The result replaces
# /app/build in the pinned image below.
#
# Frontend only, deliberately (owner decision 2026-08-11, .wolf/decisions.md
# D-036, and plan-2026-08-11-one-shell-two-panels-owui-fork section 1):
#
#   * The Python backend and its dependency set stay upstream's, so a digest
#     bump keeps giving us backend CVE fixes for free.
#   * Every backend patch below keeps working unchanged.
#   * The frontend and backend versions must therefore match, which the second
#     stage asserts rather than assumes.
#
# Measured on the development machine, cold, no layer cache: `npm ci` about 90
# seconds, `npm run build` about 420 seconds. Warm, with vendor/open-webui
# untouched, both layers are cache hits and cost nothing. NODE_OPTIONS raises
# the heap because the deploy target is the 12 GB demo box, where this build
# runs alongside the live stack.
FROM node:24-alpine3.24 AS frontend

WORKDIR /build/vendor/open-webui

# Upstream's own build stage installs git; its build reads the revision.
RUN apk add --no-cache git

COPY vendor/open-webui/package.json vendor/open-webui/package-lock.json ./
# CYPRESS_INSTALL_BINARY=0 keeps the deploy off download.cypress.io.
#
# cypress@13.17.0 is a devDependency of the vendored tree, and its postinstall
# fetches a ~120 MB desktop app from download.cypress.io at IMAGE BUILD time.
# Nothing in this stage runs Cypress: the stage runs `npm run test:frontend`
# (vitest) and `npm run build`, and the final image ships only build/. So the
# download buys nothing and costs the whole deploy whenever it fails, which it
# does on this target more than anywhere else: the demo box builds over home
# broadband behind a Cloudflare Tunnel. It took the 2026-08-24 21:44 deploy
# down outright with "The Cypress App could not be downloaded ...
# URL: https://download.cypress.io/desktop/13.17.0 ... AggregateError", which
# failed `npm ci --force`, failed the build, and stopped the deploy before a
# single container was recreated.
#
# The variable makes the postinstall a no-op rather than removing the package,
# so package-lock.json is untouched and the vendored tree stays a clean subtree
# of upstream.
RUN CYPRESS_INSTALL_BINARY=0 npm ci --force

# The design tokens live outside the vendored tree on purpose: they are plain
# CSS custom properties shared with the React applications, and keeping Hive's
# visual identity out of a tree that tracks upstream is what makes it portable.
# Copied at the same relative depth the repository has, so the stylesheet's
# `@import '../../../../../packages/hive-tokens/tokens.css'` resolves here and
# in a working tree without a second code path.
COPY packages/hive-tokens /build/packages/hive-tokens
COPY vendor/open-webui ./

ENV APP_BUILD_HASH=hive-fork
ENV NODE_OPTIONS=--max-old-space-size=4096

# The fork's own unit tests, run here because there is nowhere else they run.
# ci.yml has vitest lanes for apps/desktop, apps/web-console and
# apps/agent-console and none for vendor/open-webui, so every test written
# under src/lib/hive was coverage on paper only. Running them in this stage
# means they gate the nightly image build and the demo deploy, which is not the
# same as gating a pull request and is not being claimed as such: a PR-time
# lane for this tree is a follow-up. What it does buy is that a broken test
# cannot reach the box.
RUN npm run test:frontend -- --run

RUN npm run build && test -f build/index.html
#
# Upstream Open WebUI hardcodes a license-enforcement suffix: any custom
# WEBUI_NAME gets " (Open WebUI)" appended (backend/open_webui/env.py,
# WEBUI_NAME != 'Open WebUI' check) unless the deployment stays at <=50 end
# users per rolling 30 days, has written vendor permission, or holds an
# enterprise license (Open WebUI License, clause 4 -- see
# ghcr.io/open-webui/open-webui:v0.10.2 LICENSE). This demo deployment
# qualifies under the <=50-user carve-out; owner has authorized full removal
# regardless. Re-evaluate before any rollout that could exceed 50 users/30
# days -- get written permission or an enterprise license first.
FROM ghcr.io/open-webui/open-webui:v0.10.2@sha256:9fcea9c6e32ab60b0498f3986c6cdf651ddbe61db48d2213a3d28048ddd673d4

# The stock product surfaces Hive does not ship, turned off in the image
# itself rather than only in docker-compose.yml.
#
# All four were already off on the demo box, and only there. docker-compose.yml
# names the first three and owui-patches/hive_rag_env_config.py reconciles them
# onto the already-booted database, which is a complete control for that one
# deployment and for nothing else. The image kept upstream's defaults, all of
# which are on, so a plain `docker run` of the Hive image rendered Notes,
# Calendar, Automations and Settings > Personalization in full. That is not a
# hypothetical: it is how this repo builds its own before/after proof
# screenshots, and it is the interface the owner was looking at on 2026-08-17
# when he asked for these to go. "Off" has to be a property of the product,
# not of one compose file that a bare run, an enterprise override or the next
# proof harness can fail to repeat.
#
#   ENABLE_NOTES / ENABLE_CALENDAR / ENABLE_AUTOMATIONS -- three upstream
#     surfaces with no Hive counterpart (#772). Their navigation entries, their
#     page routes and their APIs all go with the flag, except the notes API,
#     which Caddyfile.owui blocks because notes.py checks the flag on none of
#     its nine routes.
#   ENABLE_MEMORIES -- upstream's own Memory feature, whose only surface here
#     is Settings > Personalization. Nobody chose it, and while it is on every
#     chat turn carries `features.memory: true` and pays for a lookup against a
#     second, Open WebUI owned memory store. Hive's memory subsystem is one
#     subsystem on Hive's own Postgres (.wolf/decisions.md D-020) and is not
#     built yet, so this is a competitor to it rather than an early version.
#
# ENV rather than a rewrite of upstream's own `os.getenv(..., 'True')` lines:
# there is no literal to drift on a digest bump, and compose still overrides
# it, so an enterprise deployment that wants Notes back sets the variable to
# true and hive_rag_env_config.py flips the persisted row on the next boot.
# These are persisted config keys, so on a deployment that has already booted
# the compose value plus that reconcile is still what reaches the database;
# this line governs a first boot and every run with no compose at all.
# ENABLE_VERSION_UPDATE_CHECK rides along for the same reason and is not the
# same kind of switch: it is a plain environment read rather than persisted
# config, so it needs no reconcile entry and adding one would be a no-op that
# reads like a control. docker-compose.yml has set it false since #143, and the
# image still nagged "A new version (v0.11.0) is now available" over another
# vendor's release notes on any run that did not repeat that line, including
# the before and after captures taken for this change.
ENV ENABLE_NOTES=false \
    ENABLE_CALENDAR=false \
    ENABLE_AUTOMATIONS=false \
    ENABLE_MEMORIES=false \
    ENABLE_VERSION_UPDATE_CHECK=false

# Root cause of "(Open WebUI)" in /api/config, /manifest.json,
# /opensearch.xml, and the client-rendered <title>/meta description: this
# 2-line block. WEBUI_NAME itself is still fully configurable via env var
# (see docker-compose.yml); this only removes the forced suffix.
RUN sed -i "/if WEBUI_NAME != 'Open WebUI':/,+1d" /app/backend/open_webui/env.py \
    && ! grep -q '(Open WebUI)' /app/backend/open_webui/env.py

# The pre-hydration static shell (served before the SPA's JS sets the real
# title from WEBUI_NAME) still literally says "Open WebUI" -- it's baked
# into the prebuilt frontend bundle, not templated. ponytail: plain string
# swap, not a full frontend rebuild; add a proper i18n'd title if this
# static shell ever needs more than a brand name.
#
# Both patches assert their own effect (grep -q the old pattern is gone) and
# fail the build otherwise -- sed exits 0 on a zero-match address, so without
# this a future digest bump whose upstream source shifted would silently
# rebuild with "(Open WebUI)" branding back and no build-time signal.
RUN sed -i 's/<title>Open WebUI<\/title>/<title>Hive<\/title>/' /app/build/index.html \
    && ! grep -q '<title>Open WebUI</title>' /app/build/index.html

# /manifest.json is generated by the backend rather than served from
# STATIC_DIR, so no file dropped into owui-static can reach it. Its name and
# short_name already follow WEBUI_NAME, but its description, background colour
# and maskable icon were all still Open WebUI's. See the patch module for what
# each one was and why it matters; it asserts every replacement matched and
# re-parses the module, same posture as the patches around it.
COPY deploy/docker/owui-patches/apply_manifest_patch.py /tmp/apply_manifest_patch.py
RUN python3 /tmp/apply_manifest_patch.py

# Contract check for the empty-state icon override in owui-static/custom.css.
#
# That override replaces the emoji glyph upstream uses as the primary visual
# anchor of its Workspace empty states, and it can only match by structural
# Tailwind classes because the markup carries no id, data attribute, or i18n
# hook. Two properties make the override safe, and both are asserted here so a
# future digest bump fails the build instead of silently un-branding those
# screens (or, worse, matching something new):
#
#   1. The glyph div still uses the `text-3xl mb-3` class pair.
#   2. Every occurrence of that pair is still an emoji-only glyph -- i.e. no
#      occurrence is followed by real text. If one ever is, the `font-size: 0`
#      collapse in custom.css would hide legible content, so the build stops.
#
# Same posture as the two sed patches above, which also assert their own effect.
RUN set -eu; \
    hits=$(grep -roh 'text-3xl mb-3' /app/build/_app/immutable --include='*.js' | wc -l); \
    test "$hits" -ge 1 || { \
      echo "owui-static/custom.css empty-state override is dead: no 'text-3xl mb-3' in this build" >&2; \
      exit 1; }; \
    grep -rohP "text-3xl mb-3\">.{0,4}" /app/build/_app/immutable --include='*.js' \
      | grep -vP "text-3xl mb-3\">[^<[:alnum:][:space:]]" > /tmp/textual || true; \
    if [ -s /tmp/textual ]; then \
      echo "owui-static/custom.css empty-state override now matches textual content:" >&2; \
      cat /tmp/textual >&2; \
      exit 1; \
    fi; \
    echo "empty-state override: $hits emoji-only glyph site(s) confirmed"

# #457: Supabase's third-party OIDC id_token (used for the "Continue with
# Hive" OAuth login) carries only minimal standard OIDC claims -- no
# custom owui_role claim, no user_metadata -- so Open WebUI's own
# OAUTH_ROLES_CLAIM machinery can never resolve a real tenant role for
# any login after its own first-ever-user bypass, permanently stranding
# every other user on Account Activation Pending (confirmed live against
# the physical demo box). psycopg2 and a working Postgres connection
# string (PGVECTOR_DB_URL) already exist in this image for pgvector, so
# splice in a direct tenant-role lookup instead of trying to route this
# through OAuth claims Supabase's third-party token flow will never carry.
COPY deploy/docker/owui-patches/tenant_role_from_db.py /tmp/tenant_role_from_db.py
COPY deploy/docker/owui-patches/apply_tenant_role_patch.py /tmp/apply_tenant_role_patch.py
RUN python3 /tmp/apply_tenant_role_patch.py \
    && grep -q 'hive tenant-role lookup failed' /app/backend/open_webui/utils/oauth.py

# #722: Open WebUI persists every rag.* setting on first boot and its
# seed_defaults only inserts keys that are missing, so a compose change to
# RAG_EMBEDDING_MODEL never reaches a deployment that has already booted. The
# demo box kept embedding against "text-embedding-3-small", the value compose
# shipped between 2026-05-18 and 2026-07-26, which no Hive catalog alias
# matches, so every document upload came back 404 from /v1/embeddings. Splice a
# per-key reconcile into that startup path instead of turning Open WebUI's
# whole persisted config off, which would also revert every setting an
# administrator changed in its own UI. The module names no model itself; the
# alias comes from the environment (D-001).
# Stop provisioning storing a new user's email address as their display name.
# Supabase's OAuth authorization server sends no name claim and no user
# metadata (the same finding that defeated OAUTH_ROLES_CLAIM above), and
# nothing collects a name at sign up, so Open WebUI's fallback wrote the
# address into `name` and the product greeted five of six accounts on the demo
# box by their own email address. The claim is still preferred when present;
# only the fallback changes. Existing rows are deliberately not rewritten.
COPY deploy/docker/owui-patches/hive_display_name.py /app/backend/open_webui/utils/hive_display_name.py
COPY deploy/docker/owui-patches/apply_display_name_patch.py /tmp/apply_display_name_patch.py
RUN python3 /tmp/apply_display_name_patch.py \
    && grep -q 'display_name_from_email(email)' /app/backend/open_webui/utils/oauth.py \
    && python3 -c "import ast, pathlib; ast.parse(pathlib.Path('/app/backend/open_webui/utils/oauth.py').read_text())"

COPY deploy/docker/owui-patches/hive_rag_env_config.py /app/backend/open_webui/utils/hive_rag_env_config.py
COPY deploy/docker/owui-patches/apply_rag_env_config_patch.py /tmp/apply_rag_env_config_patch.py
RUN python3 /tmp/apply_rag_env_config_patch.py \
    && grep -q 'hive: reconciled Open WebUI config from env' /app/backend/open_webui/config.py \
    && python3 -c "import ast, pathlib; ast.parse(pathlib.Path('/app/backend/open_webui/config.py').read_text())"

COPY deploy/docker/owui-patches/apply_web_search_ratelimit_patch.py /tmp/apply_web_search_ratelimit_patch.py
RUN python3 /tmp/apply_web_search_ratelimit_patch.py \
    && grep -q 'a rate limit is an error, not an empty result set' /app/backend/open_webui/retrieval/web/duckduckgo.py \
    && python3 -c "import ast, pathlib; ast.parse(pathlib.Path('/app/backend/open_webui/retrieval/web/duckduckgo.py').read_text())"

# #772: remove the stock Open WebUI surfaces that have no Hive counterpart --
# Workspace > Models (a second, instance-wide model registry that duplicates
# the Hive catalog), Workspace > Prompts, Workspace > Tools, the Playground,
# and the vendor's own Documentation and Releases links in the user menu.
# Workspace > Knowledge stays: it is the document upload behind the RAG
# surface and Hive's analogue of Claude Projects.
#
# Configuration cannot do this job. Every one of those gates reads
# `role === 'admin' || <permission>`, and this deployment promotes every
# tenant owner to Open WebUI admin (the tenant-role patch above), so a
# permission-based hide hides nothing from the people who use it. v0.10.2 has
# no environment variable for any of them either; in particular ENABLE_PLUGINS,
# which third-party Open WebUI hardening guides recommend for exactly this,
# does not exist anywhere in this image. Notes, Calendar, Automations and the
# Memory feature do have real flags and are handled by the ENV block at the top
# of this file plus docker-compose.yml and the reconcile above, not here.
#
# Two more entries were added on 2026-08-17, both inside the Settings dialog
# and both found by looking at the screen rather than at an issue: the "Admin
# Settings" link in its bottom-left corner, which is the twin of the user
# menu's Admin Panel entry #909 removed and points at the same 404'd /admin
# route, and the vendor's "Help us translate Open WebUI!" link under the
# language picker.
#
# The image ships a prebuilt bundle and no frontend source, so this rewrites
# that bundle. It asserts every rewrite matched its exact expected site count,
# that none survived, and that the surfaces Hive keeps are still present, so a
# digest bump fails the build rather than silently restoring a removed surface.
COPY deploy/docker/owui-patches/hive_ui_surfaces.py /tmp/hive_ui_surfaces.py
COPY deploy/docker/owui-patches/apply_ui_surfaces_patch.py /tmp/apply_ui_surfaces_patch.py
RUN python3 /tmp/apply_ui_surfaces_patch.py

# #782: Open WebUI runs the authorization code exchange through authlib, which
# defaults to client_secret_basic, but hand builds the refresh POST with the
# client credentials in the form body, which is client_secret_post. Supabase
# enforces the registered method exactly, so every refresh came back 400
# invalid_credentials, Open WebUI read that as a dead session and deleted it,
# and chat stopped working roughly 55 minutes after sign-in until the user
# signed in again. Splice the refresh through a helper that authenticates the
# client the same way the exchange already does, rather than requiring every
# deployment to re-register its Supabase OAuth client for the other dialect;
# the registration is manual ops with no script behind it, so an invariant
# living only in prose would be reintroduced by the next person who registers
# a client. Behaviour is covered by scripts/test_owui_oauth_client_auth.py.
COPY deploy/docker/owui-patches/hive_oauth_client_auth.py /app/backend/open_webui/utils/hive_oauth_client_auth.py
COPY deploy/docker/owui-patches/apply_oauth_client_auth_patch.py /tmp/apply_oauth_client_auth_patch.py
RUN python3 /tmp/apply_oauth_client_auth_patch.py \
    && test "$(grep -c '\*\*hive_refresh_request(client, refresh_data),' /app/backend/open_webui/utils/oauth.py)" = "2" \
    && python3 -c "import ast, pathlib; ast.parse(pathlib.Path('/app/backend/open_webui/utils/oauth.py').read_text())"
# A repeat sign-in paid one extra full HTML document for nothing: the OAuth
# callback redirected to /auth, whose only job was converting the token cookie
# into a stored session before client-side navigating to / anyway. The root
# layout in the frontend source now performs that conversion itself (the
# `token=` recovery block in vendor/open-webui/src/routes/+layout.svelte), so
# the success leg lands directly on `/`. The error leg is deliberately left
# alone: its display lives on the sign-in page, and the patch asserts that leg
# keeps targeting /auth?error=.
COPY deploy/docker/owui-patches/apply_oauth_callback_landing_patch.py /tmp/apply_oauth_callback_landing_patch.py
RUN python3 /tmp/apply_oauth_callback_landing_patch.py \
    && grep -q "redirect_base_url}/'" /app/backend/open_webui/utils/oauth.py \
    && ! grep -q "redirect_base_url}/auth'" /app/backend/open_webui/utils/oauth.py \
    && grep -q 'redirect_url}?error=' /app/backend/open_webui/utils/oauth.py \
    && python3 -c "import ast, pathlib; ast.parse(pathlib.Path('/app/backend/open_webui/utils/oauth.py').read_text())"
# Chat was broken on every route because Open WebUI attached tool schemas that
# no route in this deployment can serve.
#
# Open WebUI 0.10 injects its builtin tools (time, knowledge, chats, tasks,
# notes, channels) into every UI chat request whenever native function calling
# is on, and native is its hardcoded default: main.py resolves
# `function_calling` from the request body, then from the model registry row,
# then from the literal 'native'. This deployment populates no model registry
# (nothing curates one, and #772 removed the Workspace > Models page that
# would), so that literal always won and every request carried 21 tool specs,
# 12089 bytes of JSON, measured against this pinned
# image. On Groq that is 3144 prompt tokens for a one word answer that costs 52
# tokens without them.
#
# Both live chat failures were that payload, reproduced directly against the
# providers with the exact specs this image generates. OpenRouter answers 404
# "No endpoints found that support tool use. Try disabling
# get_current_timestamp", and the Groq free tier answers 429 against its 6000
# token per minute ceiling, since one turn plus Open WebUI's own title, tag and
# follow up task calls repeat those schemas several times inside one minute.
#
# Unlike the rag.* keys above, this is not persisted config: there is nothing
# for hive_rag_env_config.py to reconcile and upstream reads no environment
# variable for it at all. The default is a literal, so make the literal
# environment driven and let compose choose. docker-compose.yml sets
# HIVE_DEFAULT_FUNCTION_CALLING from OWUI_DEFAULT_FUNCTION_CALLING, default
# "legacy", which is Open WebUI's own name for its pre native tool path
# (utils/middleware.py gates every builtin injection on
# params.function_calling != 'legacy'). Leaving the variable unset keeps
# upstream behaviour exactly as it was, and a user who picks native in their
# own advanced params still wins, because the request body is consulted first.
RUN sed -i "s/or 'native'/or os.environ.get('HIVE_DEFAULT_FUNCTION_CALLING', 'native')/" /app/backend/open_webui/main.py \
    && grep -q "HIVE_DEFAULT_FUNCTION_CALLING" /app/backend/open_webui/main.py \
    && ! grep -q "or 'native'" /app/backend/open_webui/main.py \
    && python3 -c "import ast, pathlib; ast.parse(pathlib.Path('/app/backend/open_webui/main.py').read_text())"

# #792: keep the three non-chat catalog aliases (hive-embedding-default,
# hive-stt, hive-tts) out of the chat model picker, while the gateway keeps
# serving all six on /v1/models for direct API clients.
#
# Open WebUI's own per-model access control cannot do this job on this
# deployment, which is why #776 shipped inert. docker-compose.yml sets
# BYPASS_MODEL_ACCESS_CONTROL: "true" by design, and in this pinned image that
# skips get_filtered_models on /api/models for every role; even with the flag
# off, get_filtered_models exempts administrators whenever
# BYPASS_ADMIN_ACCESS_CONTROL is set, which defaults to true, and the
# tenant-role patch above makes every tenant owner an administrator. Measured
# on a booted v0.10.2 container: with the flag off an administrator still saw
# all six aliases while a member saw an empty picker and got HTTP 400 "Model
# not found" on every chat request, so turning the flag off buys nothing and
# breaks chat for members.
#
# The patch filters the /api/models response and nothing else. It does not
# touch request.app.state.MODELS, so chat, document RAG embeddings and
# text-to-speech all still resolve every alias. The hidden set comes from the
# environment (HIVE_PICKER_HIDDEN_MODEL_IDS plus Open WebUI's own
# RAG_EMBEDDING_MODEL / AUDIO_TTS_MODEL / AUDIO_STT_MODEL), never from a
# hardcoded list, so the admin-selectable embedding alias stays single-sourced
# (D-001).
COPY deploy/docker/owui-patches/hive_model_picker.py /app/backend/open_webui/utils/hive_model_picker.py
COPY deploy/docker/owui-patches/apply_model_picker_patch.py /tmp/apply_model_picker_patch.py
RUN python3 /tmp/apply_model_picker_patch.py \
    && grep -q 'hive_model_picker' /app/backend/open_webui/main.py \
    && python3 -c "import ast, pathlib; ast.parse(pathlib.Path('/app/backend/open_webui/main.py').read_text())"

# The agent surface renders natively in the chat frontend now, so it needs a
# server-side hop to /v1/agent/* that carries the signed-in user's own token.
# It cannot be done from the browser: this frontend holds Open WebUI's session
# token, which edge-api has never heard of, plus a Supabase OAuth-server token
# that carries no tenant_id and that edge-api fails closed on by design
# (.wolf/decisions.md D-023). That OAuth token is not in the browser either --
# Open WebUI resolves it server side and refreshes it -- so handing it to page
# JavaScript would be a downgrade rather than a fix.
#
# This router does for the agent-task calls exactly what the hive_jwt_forward
# Function already does for chat completions: present the shim key, carry the
# per-user token alongside it, and let edge-api's OWUIUnwrap middleware swap
# the two. It adds no configuration, because OPENAI_API_BASE_URL and
# OPENAI_API_KEY are already set on this container, so the shim key gains no
# new home. Frontend counterpart: vendor/open-webui/src/lib/hive/agentTasks.ts.
COPY deploy/docker/owui-patches/hive_agent_proxy.py /app/backend/open_webui/utils/hive_agent_proxy.py
COPY deploy/docker/owui-patches/apply_agent_proxy_patch.py /tmp/apply_agent_proxy_patch.py
RUN python3 /tmp/apply_agent_proxy_patch.py \
    && grep -q 'hive_agent_router' /app/backend/open_webui/main.py \
    && python3 -c "import ast, pathlib; ast.parse(pathlib.Path('/app/backend/open_webui/utils/hive_agent_proxy.py').read_text())"

# #1063: the composer's credits banner. The chat backend resolves the signed-in
# user to a balance server side (control-plane internal route behind its shared
# secret); the browser only ever sees the trimmed numbers under Open WebUI's own
# session. Deployments that do not carry the control-plane token (Hive
# Enterprise posture) get a 404 and no banner: silent absence is the posture
# gate.
COPY deploy/docker/owui-patches/hive_credits.py /app/backend/open_webui/utils/hive_credits.py
COPY deploy/docker/owui-patches/apply_credits_patch.py /tmp/apply_credits_patch.py
RUN python3 /tmp/apply_credits_patch.py \
    && grep -q 'hive_credits_router' /app/backend/open_webui/main.py \
    && python3 -c "import ast, pathlib; ast.parse(pathlib.Path('/app/backend/open_webui/utils/hive_credits.py').read_text())"

# issue #1056: ownership enforcement on the Knowledge by-id read routes. The
# listing routes honour BYPASS_ADMIN_ACCESS_CONTROL (PR #960), but GET /{id},
# GET /{id}/files (which takes include_content), GET /{id}/files/pending and
# GET /{id}/export short-circuited on user.role == 'admin', so an instance
# admin -- which every tenant OWNER is on this shared instance -- could read
# another tenant's collection given only its id. The patch applies the same
# predicate as the listings: owner, AccessGrants read grant, or admin when
# BYPASS_ADMIN_ACCESS_CONTROL is set. docker-compose.yml sets it false.
COPY deploy/docker/owui-patches/apply_knowledge_authz_patch.py /tmp/apply_knowledge_authz_patch.py
RUN python3 /tmp/apply_knowledge_authz_patch.py \
    && test "$(grep -c '# hive (#1056)' /app/backend/open_webui/routers/knowledge.py)" -eq 4 \
    && python3 -c "import ast, pathlib; ast.parse(pathlib.Path('/app/backend/open_webui/routers/knowledge.py').read_text())"

# #771: drop the Settings > Integrations tab, the chat UI's only entry point to
# "Manage Tool Servers" and "Open Terminal". Both accept an arbitrary URL and an
# auth credential. The tool servers added there are direct ones, called by the
# browser itself, so they bypass the Hive gateway entirely and no rule on the
# chat origin can reach them; removing the form is the only control that does.
# Caddyfile.owui blocks the server-side half (#770, the /api/v1/terminals proxy
# and the tool and terminal server registration endpoints), and this removes the
# UI so nothing left in the interface points at a path that now 404s.
#
# The patch asserts its own effect and fails the build otherwise, same posture
# as the patches above. The read-back grep is a second, independent check that
# the descriptor is gone from the emitted bundle.
COPY deploy/docker/owui-patches/remove_integrations_tab.py /tmp/remove_integrations_tab.py
RUN python3 /tmp/remove_integrations_tab.py \
    && ! grep -rq 'id:"tools",title:"Integrations"' /app/build/_app/immutable

# The Hive frontend replaces the prebuilt one, and it goes last on purpose.
#
# Every bundle rewrite above still runs, against the bundle it was written for,
# and this step then throws that bundle away. That reads as waste and it is
# deliberate for exactly one release. Those rewrites are exact literals over
# minified output; the identifiers inside them are allocated per chunk, so any
# edit to our own source renames them, and running them over our own build
# fails on three of nineteen entries that name surfaces which have not actually
# come back. Measured, not assumed: the first build of this stage failed on
# sidebar-playground-item, changelog-modal and about-vendor-social-badges, and
# an identifier-tolerant pattern for the last two matched sibling components
# that must not be touched.
#
# Every surface those rewrites removed is removed in the vendored source
# instead (see docs/owui-fork.md), so nothing regresses. What the steps above
# still buy is the digest-drift guard: they fail the build if a future image
# bump moves upstream's own bundle out from under the source we track. Retiring
# them is a follow-up, deliberately not in this change, because a separate
# change was in flight against hive_ui_surfaces.py and two edits to that file
# from different directions is how a surface silently returns.
#
# The version assertion below is the load-bearing half of this step. This
# image's Python backend serves whatever is in /app/build, and a frontend built
# from a different upstream release would call endpoints that moved, so a
# digest bump without a matching `git subtree pull` fails here rather than in a
# browser.
COPY --from=frontend /build/vendor/open-webui/package.json /tmp/hive-frontend-package.json
RUN set -eu; \
    vendored=$(python3 -c "import json;print(json.load(open('/tmp/hive-frontend-package.json'))['version'])"); \
    pinned=$(python3 -c "import json;print(json.load(open('/app/package.json'))['version'])"); \
    test "$vendored" = "$pinned" || { \
      echo "vendor/open-webui is $vendored but this image's backend is $pinned" >&2; \
      echo "run: git subtree pull --prefix vendor/open-webui <remote> v$pinned --squash" >&2; \
      exit 1; }; \
    rm /tmp/hive-frontend-package.json; \
    echo "hive: frontend and backend agree on $pinned"

RUN rm -rf /app/build
COPY --from=frontend /build/vendor/open-webui/build /app/build

# The Hive shell has to be in what actually ships, and the surfaces removed in
# source have to be absent from it. Cheap, and it is the one check that fails
# if the frontend stage silently built a tree without our changes in it.
#
# The admin-panel line is #949. Its removal is a source deletion, of the
# /admin route tree and of the Settings dialog's link into it, and the bundle
# rewrite that used to cover the link runs against a bundle this stage then
# discards, so nothing was checking the output. The string is a route from
# lib/components/admin/Settings.svelte's own tab table, which reaches the
# built output only through an import chain that starts at those routes: with
# them gone the component has no importer and the bundler drops it, and the
# check fails if either half comes back. Verified in both directions against
# two images built from the same digest, before and after the deletion, rather
# than assumed.
RUN set -eu; \
    grep -rqF 'data-hive-nav' /app/build/_app/immutable || { \
      echo "the built bundle carries no Hive navigation" >&2; exit 1; }; \
    grep -rqF 'HankenGrotesk-Variable' /app/build/_app/immutable || { \
      echo "the built bundle does not load the brand typeface" >&2; exit 1; }; \
    grep -rqF 'SourceSerif4-Variable' /app/build/_app/immutable || { \
      echo "the built bundle does not load the document typeface" >&2; exit 1; }; \
    ! grep -rqF '"/workspace/models"' /app/build/_app/immutable || { \
      echo "Workspace > Models came back in the built bundle" >&2; exit 1; }; \
    ! grep -rqF 'discord.gg/5rJgQTnV4s' /app/build/_app/immutable || { \
      echo "the vendor social badges came back in the built bundle" >&2; exit 1; }; \
    ! grep -rqF '/admin/settings/code-execution' /app/build/_app/immutable || { \
      echo "the Open WebUI admin panel came back in the built bundle (#949)" >&2; exit 1; }; \
    echo "hive: shell present, removed surfaces absent"
