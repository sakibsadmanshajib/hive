# Hive-branded Open WebUI image.
#
# Upstream Open WebUI hardcodes a license-enforcement suffix: any custom
# WEBUI_NAME gets " (Open WebUI)" appended (backend/open_webui/env.py,
# WEBUI_NAME != 'Open WebUI' check) unless the deployment stays at <=50 end
# users per rolling 30 days, has written vendor permission, or holds an
# enterprise license (Open WebUI License, clause 4 -- see
# ghcr.io/open-webui/open-webui:v0.10.2 LICENSE). This demo deployment
# qualifies under the <=50-user carve-out; owner has authorized full removal
# regardless. Re-evaluate before any rollout that could exceed 50 users/30
# days -- get written permission or an enterprise license first.
FROM ghcr.io/open-webui/open-webui:v0.10.2@sha256:9fcea9c6e32ab60b0498f3986c6cdf651ddbe61db48d2213a3d28048ddd673d4

# Root cause of "(Open WebUI)" in /api/config, /manifest.json,
# /opensearch.xml, and the client-rendered <title>/meta description: this
# 2-line block. WEBUI_NAME itself is still fully configurable via env var
# (see docker-compose.yml); this only removes the forced suffix.
RUN sed -i "/if WEBUI_NAME != 'Open WebUI':/,+1d" /app/backend/open_webui/env.py \
    && ! grep -q '(Open WebUI)' /app/backend/open_webui/env.py

# The pre-hydration static shell (served before the SPA's JS sets the real
# title from WEBUI_NAME) still literally says "Open WebUI" -- it's baked
# into the prebuilt frontend bundle, not templated. ponytail: plain string
# swap, not a full frontend rebuild; add a proper i18n'd title if this
# static shell ever needs more than a brand name.
#
# Both patches assert their own effect (grep -q the old pattern is gone) and
# fail the build otherwise -- sed exits 0 on a zero-match address, so without
# this a future digest bump whose upstream source shifted would silently
# rebuild with "(Open WebUI)" branding back and no build-time signal.
RUN sed -i 's/<title>Open WebUI<\/title>/<title>Hive<\/title>/' /app/build/index.html \
    && ! grep -q '<title>Open WebUI</title>' /app/build/index.html

# Contract check for the empty-state icon override in owui-static/custom.css.
#
# That override replaces the emoji glyph upstream uses as the primary visual
# anchor of its Workspace empty states, and it can only match by structural
# Tailwind classes because the markup carries no id, data attribute, or i18n
# hook. Two properties make the override safe, and both are asserted here so a
# future digest bump fails the build instead of silently un-branding those
# screens (or, worse, matching something new):
#
#   1. The glyph div still uses the `text-3xl mb-3` class pair.
#   2. Every occurrence of that pair is still an emoji-only glyph -- i.e. no
#      occurrence is followed by real text. If one ever is, the `font-size: 0`
#      collapse in custom.css would hide legible content, so the build stops.
#
# Same posture as the two sed patches above, which also assert their own effect.
RUN set -eu; \
    hits=$(grep -roh 'text-3xl mb-3' /app/build/_app/immutable --include='*.js' | wc -l); \
    test "$hits" -ge 1 || { \
      echo "owui-static/custom.css empty-state override is dead: no 'text-3xl mb-3' in this build" >&2; \
      exit 1; }; \
    grep -rohP "text-3xl mb-3\">.{0,4}" /app/build/_app/immutable --include='*.js' \
      | grep -vP "text-3xl mb-3\">[^<[:alnum:][:space:]]" > /tmp/textual || true; \
    if [ -s /tmp/textual ]; then \
      echo "owui-static/custom.css empty-state override now matches textual content:" >&2; \
      cat /tmp/textual >&2; \
      exit 1; \
    fi; \
    echo "empty-state override: $hits emoji-only glyph site(s) confirmed"

# #457: Supabase's third-party OIDC id_token (used for the "Continue with
# Hive" OAuth login) carries only minimal standard OIDC claims -- no
# custom owui_role claim, no user_metadata -- so Open WebUI's own
# OAUTH_ROLES_CLAIM machinery can never resolve a real tenant role for
# any login after its own first-ever-user bypass, permanently stranding
# every other user on Account Activation Pending (confirmed live against
# the physical demo box). psycopg2 and a working Postgres connection
# string (PGVECTOR_DB_URL) already exist in this image for pgvector, so
# splice in a direct tenant-role lookup instead of trying to route this
# through OAuth claims Supabase's third-party token flow will never carry.
COPY deploy/docker/owui-patches/tenant_role_from_db.py /tmp/tenant_role_from_db.py
COPY deploy/docker/owui-patches/apply_tenant_role_patch.py /tmp/apply_tenant_role_patch.py
RUN python3 /tmp/apply_tenant_role_patch.py \
    && grep -q 'hive tenant-role lookup failed' /app/backend/open_webui/utils/oauth.py
