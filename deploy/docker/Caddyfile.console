# web-console reverse proxy (self-hosted migration off Cloudflare Workers).
#
# Own origin, not shared with caddy-owui or caddy-artifacts: same isolation
# rationale as Caddyfile.artifacts -- a distinct hostname is what keeps this
# app's session cookies out of reach of anything served from HIVE_CHAT_URL or
# ARTIFACTS_DOMAIN, regardless of any in-app defence.
#
# The site address keeps the hostname so the host match still holds, and
# carries an explicit http:// scheme: Caddy turns on automatic HTTPS when a
# site address has no scheme, which redirects plain-HTTP requests back to
# itself and loops forever behind an external TLS terminator (Cloudflare
# Tunnel) -- the same bug already fixed once for Caddyfile.artifacts (PR
# #434, "fix: stop artifacts Caddy site from redirecting to itself forever").
# Naming the scheme disables that redirect without giving up host matching.
#
# X-Forwarded-Proto is stamped explicitly (not trusted from the incoming
# request, since this listener is published on a host port and an inbound
# X-Forwarded-Proto would otherwise be attacker-controlled) so anything
# upstream that derives an absolute URL from request scheme sees the scheme
# users actually arrive on, same pattern as Caddyfile.owui.
# Who is allowed to tell this Caddy who the client is.
#
# This listener is published on a host port and reached from the Cloudflare
# Tunnel, which runs on the host, so its direct peer is always a private
# address: the Docker bridge gateway for tunnel traffic, another container for
# in-network traffic. Nothing on the public internet is ever the peer. Trusting
# the private ranges therefore trusts exactly the set that can already reach
# port 3005, and no more.
#
# Cf-Connecting-Ip is preferred because Cloudflare SETS it on every request,
# overwriting whatever the browser sent, so an internet caller cannot choose
# its own value. X-Forwarded-For is the fallback for a terminator that is not
# Cloudflare; when neither header is present {client_ip} is the peer address,
# which is the old behaviour rather than an empty value. That fallback matters:
# GoTrue treats an EMPTY rate-limit header as "no rate limiting at all", so a
# blank value here would fail open rather than merely lose precision.
{
	servers {
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip X-Forwarded-For
	}
}

http://{$CONSOLE_DOMAIN:console.localhost} {
  # Compress compressible responses for every route in this block (directives
  # are sorted, so encode wraps the handle and reverse_proxy blocks below).
  # Already-compressed content types (images, video, archives) are excluded by
  # Caddy's default compression filter.
  encode zstd gzip
  # The public auth origin, served from this app's OWN origin rather than a
  # second public hostname.
  #
  # A self-hosted data plane has no browser-reachable Supabase address of its
  # own: SUPABASE_URL is `http://caddy-supabase`, a compose service name, so
  # every browser-facing consumer (supabase-js in this app's bundle, and the
  # endpoints inside GoTrue's own OIDC discovery document) pointed at an
  # address that resolves nowhere. That is what took browser login down after
  # the cutover, and this route is the fix.
  #
  # Why here and not on a hostname of its own:
  #
  #   * The tunnel in front of this box is REMOTELY managed. There is no
  #     ingress config on the box (`~/.cloudflared` holds credentials and
  #     nothing else), so a new public hostname is a Cloudflare dashboard edit
  #     that no file in this repository and no deploy step can make or
  #     reproduce. This route needs neither a new hostname nor a new DNS
  #     record.
  #   * Same origin means supabase-js makes same-origin requests, so the
  #     gateway's CORS termination stops standing between a user and a working
  #     sign-in, and no third-party-cookie behaviour is involved at all.
  #   * It covers everything this app asks Supabase for. Measured, not
  #     assumed: apps/web-console has no `.from()` and no `.storage` call
  #     anywhere, only auth, so /auth/v1 is the whole surface its bundle uses.
  #     Nothing in the app serves a path under /auth/v1 either, so this
  #     shadows no route of its own (app/auth holds sign-in, sign-up,
  #     callback and friends; there is no `v1` among them).
  #
  # The upstream is caddy-supabase's PUBLIC listener on 8080, and that choice
  # is the security boundary, not a detail. Port 80 on that container carries
  # the internal route set, which is /rest/v1, /storage/v1 and an unrefused
  # admin API; supabase-auth:9999 is GoTrue with no route filtering at all.
  # Either one here would publish all of that to the internet through this
  # hostname. Port 8080 is the listener whose route set is reviewed, where the
  # admin API, /invite, dynamic OAuth client registration, /signup and
  # /magiclink are refused. See Caddyfile.supabase.
  #
  # `handle`, never `handle_path`: the prefix must survive, because the public
  # listener is the thing that strips it before handing the request to GoTrue.
  # Stripping here would deliver /token to a listener expecting /auth/v1/token
  # and every route would 404.
  #
  # Host is rewritten because caddy-supabase's public site block is host
  # matched on SUPABASE_DOMAIN, and an unmatched Host on that port hits its
  # catch-all and answers 404 to everything. Both sides spell the SAME
  # expression, `{$SUPABASE_DOMAIN:supabase.localhost}`, and both containers
  # read that variable from the one project env file, so they agree by
  # construction rather than by someone remembering to keep two values in
  # step. scripts/test_caddy_console_auth_origin.py fails if they diverge.
  #
  # X-Forwarded-For is REPLACED with the resolved client address rather than
  # appended to, and that is the rate-limit bucket key GoTrue will spend
  # (GOTRUE_RATE_LIMIT_HEADER). Before issue #1744 the public listener rewrote
  # it to its own peer, which is this container, so every visitor on the
  # internet shared one bucket: thirty requests from one host exhausted the
  # deployment's whole hourly quota and 429'd everybody else's password reset.
  # Sending the real client address is what splits that into one bucket per
  # caller. The caller cannot choose it, per the global block at the top of
  # this file.
  # A NAMED matcher, because `handle` takes exactly one matcher token and
  # `handle /auth/v1 /auth/v1/*` is a parse error, not a longer list. Caddy
  # refuses to adapt the file and the container crash-loops, which is how this
  # was found: every structural check in this repo reads the file as text, so
  # all of them passed on a config Caddy would not load. CI now adapts every
  # Caddyfile for that reason.
  #
  # The bare form is in the list on purpose, so a request to /auth/v1 reaches
  # the gateway rather than falling through to a Next.js 404 naming nothing.
  @auth path /auth/v1 /auth/v1/*
  handle @auth {
    reverse_proxy caddy-supabase:8080 {
      # Bounded dial retry across a container recreate, #1407. This origin
      # served 3 of the 58 measured 502s, and like the chat origin's 55 they
      # fell inside deploy-demo-box.yml run windows: the console's own report
      # was `lookup web-console-prod on 127.0.0.11:53: server misbehaving`,
      # which is Docker's embedded DNS forwarding a deregistered container
      # name to the host resolver and relaying its SERVFAIL. Full reasoning,
      # including why an explicit `resolvers` would not help and what the 30s
      # bound costs a genuinely broken upstream, is written out once at the
      # @agentConsole block of Caddyfile.owui.
      lb_try_duration 30s
      lb_try_interval 1s
      header_up Host {$SUPABASE_DOMAIN:supabase.localhost}
      header_up X-Forwarded-For {client_ip}
      header_up X-Forwarded-Proto {$CONSOLE_EXTERNAL_SCHEME:http}
      transport http {
        response_header_timeout 30s
        dial_timeout 5s
      }
    }
  }

  handle {
    reverse_proxy web-console-prod:3000 {
      # Bounded dial retry across a container recreate, #1407. Reasoning at the
      # auth-origin block above.
      lb_try_duration 30s
      lb_try_interval 1s
      header_up X-Forwarded-Proto {$CONSOLE_EXTERNAL_SCHEME:http}
      transport http {
        response_header_timeout 30s
        dial_timeout 5s
      }
    }
  }
}
