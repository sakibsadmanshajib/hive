# When an external terminator (Cloudflare Tunnel on the demo box) handles TLS,
# Caddy itself only ever sees plain HTTP on :80 and would stamp
# X-Forwarded-Proto: http on every upstream request. Both upstreams below
# derive absolute URLs from that header -- Open WebUI's authlib builds its
# OAuth redirect_uri from the request scheme rather than from WEBUI_URL, and
# the agent console builds redirects from request.url -- so an http value
# makes Supabase reject the redirect_uri with a 400. HIVE_CHAT_EXTERNAL_SCHEME
# names the scheme users actually arrive on and defaults to http for plain
# local and enterprise runs. Same failure family as the Caddyfile.artifacts
# auto-HTTPS fix (#434): Caddy behind an external TLS terminator needs
# explicit scheme handling. Set rather than trusted from the incoming request
# on purpose: this listener is published on a host port, so an incoming
# X-Forwarded-Proto is attacker-controlled and must not be believed.
:80 {
  # Compress compressible responses for every route in this block (directives
  # are sorted, so encode wraps the matchers, respond and reverse_proxy below).
  # Already-compressed content types (images, video, archives) are excluded by
  # Caddy's default compression filter.
  encode zstd gzip
  # Defence-in-depth admin block. Open WebUI's env flags can regress across
  # releases (admin panel re-enabled by a misconfigured chart), so the proxy
  # answers 404 on every variant of the admin and signup paths regardless of
  # casing or trailing slashes. 404 (not 403) avoids confirming the path
  # exists at all.
  # Path-level admin/signup block. Caddy's path_regexp is anchored at
  # the start; the trailing `/?` + `(?:/.*)?` arms tolerate any
  # combination of trailing slash, query string, or sub-paths. The
  # leading `/+` collapses path-traversal variants like `//admin`.
  #
  # The `api(?:/v[0-9]+)?/` arm exists because every alternative before it
  # is anchored at `^/+` and therefore only ever covered the bare SPA
  # routes, never the real API mount. `/auths/signup` was blocked while
  # `POST /api/v1/auths/signup` -- the endpoint that actually creates an
  # account -- was not. Same for the `/api/v1/auths/admin/*` family
  # (`/admin/details`, `/admin/config`, and the ldap and oauth children),
  # which read and write admin configuration including OAuth settings.
  #
  # `configs/export` and `openai/config` close #769: both return the live
  # gateway key seeded from OWUI_SHIM_KEY, and `configs/export` also
  # returns `oauth.client_secret`. Both are matched as whole path segments
  # rather than as prefixes, which is load-bearing in three places:
  #   * `/api/v1/configs/banners` is read by the front end on every page
  #     load, so a `configs*` prefix would break the chat UI outright.
  #   * `/openai/models` and `/openai/chat/completions` carry the model
  #     picker and the chat itself, so an `openai*` prefix would break both.
  #   * `/api/v1/auths/signin` is the login POST and must stay reachable,
  #     which is why the api arm lists `auths/(?:signup|admin)` and not a
  #     bare `auths/` prefix.
  # `/openai/config/update` is caught as a child of `/openai/config`, on
  # purpose: it rewrites the persisted gateway key, so it is a credential
  # write on a public origin. Known consequence, see #769: the OWUI config
  # sync in scripts/seed-owui-e2e-user.py defaults OWUI_BASE_URL to
  # http://localhost:3003, which is this listener, and reads GET
  # /openai/config before pushing the rotated key. That sync now has to run
  # against Open WebUI's own port from inside the network, the same
  # rerouting #736 requires for the Function installer. It fails safe: the
  # script treats a non-200 as a failure and deliberately does not revoke
  # the previous key, so a deployment is never stranded on a dead one.
  #
  # `configs/import` and `configs/namespace` close #948: two sibling routes in
  # the same router return the same values `configs/export` was blocked for.
  # `import_config` ends with `return await Config.get_all()`, the identical
  # call `export_config` makes, so a POST with any body reads back the whole
  # persisted configuration -- gateway key and `oauth.client_secret` included --
  # and overwrites configuration on the way through. `GET
  # /namespace/{namespace}` needs no body at all: `oauth` returns
  # `oauth.client_secret`, `rag` returns `rag.openai.api_key`, which is
  # OWUI_SHIM_KEY. Both are admin-only in Open WebUI and nothing else, and on
  # this deployment every tenant OWNER holds an administrator session (#748),
  # so the session check is the only thing that was in front of them. Blocked
  # here for every verb rather than only for writes, because the disclosure
  # half is a GET. Segment-exact like their sibling above, so
  # `configs/banners`, `configs/models` and `configs/connections` still reach
  # Open WebUI; `namespace` carries its namespace as a child path segment,
  # which the trailing `(?:/.*)?` of this matcher covers.
  #
  # `terminals` closes #770. Open WebUI mounts routers/terminals.py at
  # /api/v1/terminals and gates none of it on `get_admin_user`: the
  # `{server_id}/{path:path}` route proxies every HTTP verb, and the
  # `{server_id}/api/terminals/{session_id}` websocket opens an interactive
  # session, both on `get_verified_user` alone, each attaching the
  # server-side credential the connection was registered with. That is an
  # authenticated request-forgery primitive against anything the chat
  # container can reach, including the other services on the compose
  # network. Blocking the whole router is correct here because this
  # deployment offers no terminal feature at all. Nothing in this repo calls
  # it, and the front end degrades cleanly: the only caller of
  # `GET /api/v1/terminals/` is `getTerminalServers`, which returns `[]` on
  # any non-2xx, so the terminal list is empty rather than errored, and the
  # message input's terminal menu renders only when that list is non-empty.
  #
  # `configs/tool_servers` and `configs/terminal_servers` close #771. Those
  # are the registration endpoints behind the admin panel's forms: each
  # accepts a caller-supplied destination URL and credential with no
  # allowlist, and #770's proxy is what then uses what they store. Their
  # `verify`, `policy`, `lifecycle`, and `refresh` children are caught as
  # sub-paths, which is intended -- `verify` alone will dial an arbitrary
  # caller-supplied URL from inside the network. Segment-exact for the same
  # reason as `configs/export` above: `/api/v1/configs/banners`,
  # `/api/v1/configs/models`, and `/api/v1/configs/connections` all sit in
  # the same namespace and must stay reachable. Note `terminals` and `tools`
  # are different routers; `/api/v1/tools/` is the Workspace tool list and
  # is deliberately untouched.
  #
  # This is the server-side half only. The tool servers added from Settings
  # > Integrations are `direct` ones, fetched by the browser straight from
  # the configured URL, so no rule on this origin can see them. Removing
  # that panel is the control that reaches them, and it happens at image
  # build time -- see deploy/docker/owui-patches/remove_integrations_tab.py.
  #
  # `notes` is the one removed product surface whose API needs a rule here.
  # Turning a feature flag off is an honest removal only when the flag reaches
  # the API too, and for the rest of #772's flag-backed list it does: in the
  # pinned v0.10.2 image calendar.py checks `calendar.enable` on all 13 of its
  # routes, automations.py checks `automations.enable` on all 8, and
  # memories.py checks `memories.enable` on all 11, so a second control here
  # would be decoration. notes.py checks `notes.enable` on none of its 9. With
  # the navigation entry gone from the bundle and the /notes page already
  # answered below, all nine endpoints stayed callable by any signed-in user,
  # which is the "hidden entry pointing at live code" shape this block exists
  # to prevent. Nothing in the interface calls them: every caller in the
  # front end (the sidebar's pinned note list, the message input's Attach
  # Notes tab and its note-from-prompt action, the note link token) renders
  # only under `$config.features.enable_notes`.
  # `knowledge/<id>/export` closes the residual half of #947 that the two
  # environment flags below in docker-compose.yml cannot reach.
  #
  # Those flags gate the LISTING routes (routers/knowledge.py `GET /` and
  # `GET /search`), so with them off an admin no longer discovers other
  # tenants' collections. They do not gate this one. `export_knowledge_by_id`
  # depends on `get_admin_user` and nothing else: no ownership check, no
  # BYPASS_ADMIN_ACCESS_CONTROL check, and, unlike every sibling export route
  # (`chats.py` and `routers/utils.py` both check it), no ENABLE_ADMIN_EXPORT
  # check either. So a tenant OWNER, who is an instance admin here, could
  # still download another tenant's entire collection as a zip given only its
  # id, which is not secret in the way a credential is: it travels in shared
  # links, support tickets, logs and screenshots.
  #
  # Blocked here rather than patched in Python because Dockerfile.open-webui
  # builds only the frontend from vendor/open-webui, so an edit to
  # routers/knowledge.py is inert unless it goes through owui-patches. This
  # proxy already owns exactly this kind of defence-in-depth block, and the
  # route has no legitimate caller: the product surfaces no Knowledge export,
  # and ENABLE_ADMIN_EXPORT is already false for the routes that honour it.
  #
  # Deliberately NOT blocking `GET /api/v1/knowledge/<id>` or its `/files`
  # children, which an owner uses to open their own collection: those now
  # enforce ownership in the backend itself through owui-patches'
  # apply_knowledge_authz_patch.py (#1056). This block stays scoped to the
  # export route, which has no legitimate caller in this product at all.
  @blocked {
    path_regexp blocked (?i)^/+(?:admin|signup|signin|signup\.html|register|create-account|users/new|invite|auth/signup|auth/signin|auth/register|auths/signup|auths/signin|openai/config|api(?:/v[0-9]+)?/(?:admin|signup|register|invite|notes|terminals|users/admin|users/new|auths/(?:signup|admin)|configs/(?:export|import|namespace|terminal_servers|tool_servers)|knowledge/[^/]+/export))/?(?:/.*)?$
  }
  respond @blocked 404

  # #772: the stock Open WebUI product surfaces Hive does not ship. Their
  # navigation entries are removed from the built bundle
  # (owui-patches/apply_ui_surfaces_patch.py) or turned off by feature flag,
  # but the SPA routes themselves still exist upstream, so a typed or
  # bookmarked URL would still render them. Same 404-not-403 posture and same
  # tolerance for trailing slashes, sub-paths and `//` traversal variants as
  # the admin block above.
  #
  # Scoped to the page routes only. Open WebUI's own APIs live under /api, so
  # this never touches /api/v1/notes and friends, and /workspace and
  # /workspace/knowledge stay reachable because Knowledge is the one workspace
  # surface Hive keeps.
  @removedSurfaces {
    path_regexp removed (?i)^/+(?:playground|notes|calendar|automations|workspace/+(?:models|prompts|skills|tools))/?(?:/.*)?$
  }
  respond @removedSurfaces 404

  # Method-level block on admin-only endpoints that OWUI exposes under
  # /api/v1/configs/*. Even if a future regression re-exposes the
  # admin panel under a non-blocked path, mutation verbs are dropped.
  #
  # `/api/v*/admin*` and `/api/v*/roles*` were removed here because Open
  # WebUI mounts no such routers (confirmed against the pinned
  # hive-open-webui:v0.10.2-branded image: the only prefixes are
  # /api/v1/<router> for the routers it registers, plus /ollama and
  # /openai). They matched nothing and made this list read as broader
  # coverage than it has.
  #
  # The three globs LEFT here still under-match by design of Caddy's `path`,
  # which falls through to Go path.Match where `*` never crosses `/`, so
  # `/api/v*/groups*` covers `/api/v1/groups` and nothing below it. That
  # residue is #437, and it is not fixable by widening these three the way
  # the two below were widened: `/api/v1/users/user/settings/update`,
  # `/user/status/update` and `/user/info/update` are `get_verified_user`
  # routes that every signed-in session writes, and in models.py `create`,
  # `import`, `model/toggle`, `model/update`, `model/access/update` and
  # `model/delete` are all `get_verified_user` too. A subtree block on
  # `users` or `models` would therefore be an outage, not a fix; closing
  # #437 needs a per-route allowlist, which is a separate change.
  @adminMutation {
    method PUT POST PATCH DELETE
    path /api/v*/users/* /api/v*/groups* /api/v*/models*
  }
  respond @adminMutation 404

  # #736 and #948: the `configs` and `functions` arms of the same block,
  # rewritten as a regexp so they actually reach the sub-paths the admin
  # panel and the Functions API live on. `path /api/v*/functions*` matched
  # `/api/v1/functions` and, because a Go path.Match `*` never crosses a
  # slash, none of `/create`, `/id/<id>/update`, `/id/<id>/toggle` or
  # `/id/<id>/toggle/global` -- every endpoint that installs and enables
  # plugin code inside this container, which holds PGVECTOR_DB_URL and
  # OWUI_SHIM_KEY. Same shape for `configs`, whose live children include
  # `code_execution` (an arbitrary Jupyter URL and token), `connections`
  # (browser-direct endpoints that bypass the gateway and its billing) and
  # `import` (overwrites every persisted key).
  #
  # Written as default-deny over both subtrees rather than as a list of the
  # endpoints that exist today, because the list is the failure mode: this
  # is the fourth patch to the same family, and an upstream bump that adds
  # an admin write route must not quietly land outside the block. Every
  # write route under both prefixes is `get_admin_user` in the pinned
  # v0.10.2 image, with exactly one exception, carved out by the `not`
  # below: `POST /api/v1/functions/id/{id}/valves/user/update` is
  # `get_verified_user` and writes only the calling user's own valve
  # values, so blocking it would take a user-scoped write with it.
  #
  # The demo deploy no longer depends on the gap this closes. The
  # hive_jwt_forward install used to run through this origin -- that is what
  # #736 records -- and now runs inside the chat container against Open
  # WebUI's own loopback, through
  # scripts/install-owui-jwt-forward-in-container.sh. Reroute first, then
  # block: closing this before that script existed would have failed every
  # deploy at the install step.
  @adminMutationSubtree {
    method PUT POST PATCH DELETE
    path_regexp adminsubtree (?i)^/+api/v[0-9]+/+(?:configs|functions)(?:/.*)?$
    not path_regexp uservalves (?i)^/+api/v[0-9]+/+functions/+id/+[^/]+/+valves/+user/+update/?$
  }
  respond @adminMutationSubtree 404

  # Blueprint Step 3.1 (#311) agent console sidecar. Path-prefixed, not a
  # subdomain, so it shares this listener and the /admin, /signup, and
  # mutation blocks above without any new Caddy site block or cert.
  #
  # Collision analysis: Open WebUI has no route under /agent-workspace (its
  # own paths are the SPA root, /api/*, /ws, and /static/*), and Caddy
  # directives of the same name run in the order they're written in this
  # file (documented Caddyfile behaviour for repeated directives), so this
  # matched reverse_proxy is always evaluated -- and can intercept --
  # before the unmatched catch-all below ever sees the request. OWUI's own
  # websocket traffic is untouched since it lives on a different path.
  # Matches both the bare entry URL (/agent-workspace, no trailing slash --
  # what a freshly-typed or bookmarked link looks like) and everything
  # under it. The bare path proxies straight to the Next.js app's own root
  # route, which (via basePath) redirects to /agent-workspace/tasks itself
  # (apps/agent-console/app/page.tsx) -- no separate Caddy redirect needed.
  @agentConsole path /agent-workspace /agent-workspace/*
  reverse_proxy @agentConsole agent-console:3000 {
    header_up X-Forwarded-Proto {$HIVE_CHAT_EXTERNAL_SCHEME:http}
    transport http {
      response_header_timeout 60s
      dial_timeout 5s
    }
  }

  # `/api/v1/hive/*` is deliberately left to the catch-all below, and the
  # reason is written here so a future reviewer does not have to re-derive it
  # from three regexes.
  #
  # That prefix is Hive's own FastAPI router inside the chat container
  # (deploy/docker/owui-patches/hive_agent_proxy.py), and it has to stay
  # browser-reachable: the native agent surface calls it from the page. It
  # matches none of the blocks above, which is correct rather than accidental.
  # `@blocked` lists literal segments after `api/v1/` and `hive` is not one;
  # `@removedSurfaces` matches page routes only; `@adminMutation` globs
  # `configs*`, `users/*`, `groups*`, `functions*` and `models*`, none of which
  # match `hive/agent/tasks`, so the create and cancel POSTs stay reachable.
  #
  # It is not the shape #770 and #771 blocked. Those are stock Open WebUI
  # routers that proxy to a caller-supplied destination with a stored
  # credential, and this deployment offers no such feature. This router is four
  # named operations, every one behind Open WebUI's own `get_verified_user`,
  # with the task id validated as a UUID and the outbound body rebuilt from two
  # named fields. Blocking it here would break the feature and secure nothing.

  # Agent-task API on the chat origin. The task console runs in the browser
  # and calls edge-api directly, but edge-api serves no CORS headers at all,
  # so a cross-origin base URL (api-hive.scubed.co while the page is served
  # from the chat host) fails preflight and the console can neither list nor
  # start tasks. Routing these paths through this same listener makes those
  # calls same-origin, which needs no CORS. Auth is unchanged: edge-api still
  # validates the caller's Supabase bearer token on every request. Scoped to
  # /v1/agent/* on purpose -- the rest of the gateway API stays off this host.
  @agentApi path /v1/agent/*
  reverse_proxy @agentApi edge-api:8080 {
    header_up X-Forwarded-Proto {$HIVE_CHAT_EXTERNAL_SCHEME:http}
    transport http {
      response_header_timeout 60s
      dial_timeout 5s
    }
  }

  # Desktop entitlement probe (#619). The desktop app derives its console
  # origin and calls {origin}/v1/featuregate directly, so this one path needs
  # the same edge-api same-origin treatment as @agentApi above. Scoped to the
  # single path on purpose -- the rest of /v1/* stays off this host.
  @featureGate path /v1/featuregate /v1/featuregate/
  reverse_proxy @featureGate edge-api:8080 {
    header_up X-Forwarded-Proto {$HIVE_CHAT_EXTERNAL_SCHEME:http}
    transport http {
      response_header_timeout 60s
      dial_timeout 5s
    }
  }

  # SvelteKit writes a content hash into every file name under
  # /_app/immutable, so a given URL's bytes can never change: a new build
  # produces new names. The chat backend serves them with no Cache-Control at
  # all, which leaves the caching policy to whatever sits in front. On the
  # demo box that is Cloudflare, whose default browser TTL is four hours, so
  # a returning user revalidates every one of roughly 155 chunks after half a
  # day away, for files that are incapable of having changed. State the real
  # lifetime here instead: a year, plus `immutable` so the browser skips the
  # conditional request entirely rather than sending an If-None-Match and
  # waiting for a 304.
  #
  # Scoped to /_app/immutable only. Everything else on this origin (the HTML
  # entry point above all) must stay revalidated, because a deploy has to be
  # able to change it.
  @immutableAssets path /_app/immutable/*
  header @immutableAssets Cache-Control "public, max-age=31536000, immutable"

  reverse_proxy open-webui:8080 {
    header_up X-Forwarded-Proto {$HIVE_CHAT_EXTERNAL_SCHEME:http}
    transport http {
      response_header_timeout 60s
      dial_timeout 5s
    }
  }
}
