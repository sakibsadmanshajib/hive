# Next.js
.next/
out/

# OpenNext Cloudflare bundle (npm run build:cf)
.open-next/

# Dependencies
node_modules/

# Build output
build/
dist/

# Local env files
.env*.local

# Playwright storage state. These files hold live session cookies.
.auth/
tests/e2e/.auth/
e2e/**/.auth/

# Coverage ledgers built from a live probe run by
# scripts/build-agent-workspace-coverage.mjs. Generated, never committed: a
# checked-in snapshot reports the same ratio forever, including after the
# coverage it describes has changed. CI uploads it as a run artifact instead.
tests/e2e/_probe/*-coverage.json

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Override root-level lib/ exclusion (Python build artifact pattern)
# The lib/ directory here contains Next.js source code, not Python build artifacts.
!lib/
